# ============================================
# AIRWISE Environment Configuration
# ============================================
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# NEVER commit .env.local or secret keys to version control.
# .env.local is automatically Git-ignored.
# ============================================

# --------------------------------------------
# Google Gemini API Configuration
# --------------------------------------------
# Optional: Required for GenAI personalization and interactive chat.
# If omitted or empty, AIRWISE operates 100% functionally using its
# built-in deterministic public health decision engine and scientific fallbacks.
# Obtain a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model override (defaults to gemini-3.8-flash)
# Supported options:
#   gemini-3.8-flash       - Primary model: high intelligence, multi-step reasoning, fast (recommended)
#   gemini-3.5-flash-lite  - Lightweight alternative: ultra-low latency, maximum cost efficiency
# Note: gemini-2.5-flash is deprecated and scheduled for retirement on December 1, 2026.
GEMINI_MODEL=gemini-3.8-flash

# Optional: API timeout in milliseconds (defaults to 15000)
GEMINI_TIMEOUT_MS=15000

# --------------------------------------------
# Environmental Data Provider (Open-Meteo)
# --------------------------------------------
# Open-Meteo Air Quality uses Copernicus CAMS model estimates.
# NO API KEY REQUIRED (Free tier supports up to 10,000 requests/day).

# --------------------------------------------
# Server & Network Configuration
# --------------------------------------------
# Optional: HTTP server port (defaults to 3001)
PORT=3001

# Optional: Runtime environment (development, production, test)
NODE_ENV=development

# Optional: Frontend URL for CORS protection (defaults to http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Trusted reverse proxy hops (defaults to 1 on Vercel, false in local development)
# For security, blanket "true" is rejected. Only a validated positive integer (e.g. 1) is accepted.
# TRUST_PROXY=1
